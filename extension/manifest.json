{
  "manifest_version": 3,
  "name": "LeetCode Session → GitHub Secrets",
  "version": "1.0.0",
  "description": "Captures your LeetCode session + csrf cookies on login and pushes them to your repo's GitHub Actions secrets.",
  "permissions": ["cookies", "storage", "notifications"],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Push LeetCode session to GitHub",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
